<+># dictionary = a collection of {key:value} pairs\r\n#              ordered and changeable. No duplicates\r\n\r\ncapitals = {\"USA\": \"Washington D.C\",\r\n            \"India\": \"New Delhi\",\r\n            \"Sri Lanka\": \"Colombo\",\r\n            \"China\": \"Beiging\",\r\n            \"Russia\": \"Moscow\"}\r\n\r\n#print(dir(capitals))\r\n#print(help(capitals))\r\n\r\nprint(capitals.get(\"India\"))\r\nprint(capitals.get(\"Sri Lanka\"))\r\n
